{
  "contract": "recipe.contract.v1",
  "id": "recipe.project.cleanup_trial_created_objects",
  "title": "Cleanup trial created objects",
  "summary": "Draft destructive workflow that deletes bounded trial-created items, tracks, marker, and region refs after confirmation.",
  "pack": "project",
  "lifecycle": "draft",
  "risk": "destructive",
  "entity_kind": "trial_cleanup",
  "tags": [
    "project",
    "cleanup",
    "delete",
    "trial",
    "session_ledger"
  ],
  "workflow_card": {
    "intent": "Clean up OpenReaper trial-created objects without broad project reset.",
    "entry_conditions": [
      "Use only canonical refs from the same session ledger or explicit user confirmation.",
      "Stop when ownership is ambiguous."
    ],
    "supported_steps": [
      "Read compact project state before deletion.",
      "Delete explicit trial item refs.",
      "Delete explicit trial track refs.",
      "Delete explicit marker and region refs.",
      "Read compact project state after cleanup."
    ],
    "candidate_steps": [
      "Future lanes may add richer ledger projections after base acceptance."
    ],
    "blocked_steps": [
      "Do not use public call_recipe or a hidden recipe executor.",
      "Do not reset the whole project or delete by name-only guesses."
    ],
    "required_questions": [
      "Ask for confirmation unless every object ref is session-ledger owned."
    ],
    "template_atoms": [
      "template.project.read_track_item_overview",
      "template.items.delete_items",
      "template.tracks.delete_tracks",
      "template.project.delete_marker",
      "template.project.delete_region"
    ],
    "evidence_required": [
      "template.runtime.evidence.v1 with request id",
      "compact file evidence before long chat output"
    ],
    "cleanup_plan": "This recipe is cleanup; stop on ambiguous refs instead of broadening deletion.",
    "typed_blockers": [
      "no_public_call_recipe_executor",
      "cleanup_requires_canonical_session_or_confirmed_refs"
    ],
    "token_budget": {
      "menu_max_bytes": 4096,
      "exact_max_bytes": 32768,
      "compact_chat_max_items": 5,
      "same_typed_blocker_stop_after": 2
    }
  },
  "steps": [
    {
      "id": "read_before_trial_cleanup",
      "title": "Read before trial cleanup",
      "summary": "Read compact project state before deleting trial-created objects.",
      "uses": "call_template",
      "call_template": {
        "id": "template.project.read_track_item_overview",
        "input": {
          "max_tracks": 64,
          "max_items_per_track": 8,
          "include_selected_items": true
        },
        "refs": {}
      },
      "get_state": null,
      "checkpoint": "checkpoint_read_before_trial_cleanup",
      "evidence": "evidence_read_before_trial_cleanup",
      "idempotency": {
        "mode": "none",
        "key_scope": "none",
        "on_resume": "rerun"
      },
      "on_failure": "branch_request_user"
    },
    {
      "id": "delete_trial_items",
      "title": "Delete trial items",
      "summary": "Delete bounded item refs created during the trial.",
      "uses": "call_template",
      "call_template": {
        "id": "template.items.delete_items",
        "input": {
          "require_selected": false
        },
        "refs": {
          "item_ref": {
            "kind": "item",
            "ref": "item:session:trial_created_items",
            "identity": {
              "scheme": "session_ledger",
              "value": "trial_created_items"
            }
          }
        }
      },
      "get_state": null,
      "checkpoint": "checkpoint_delete_trial_items",
      "evidence": "evidence_delete_trial_items",
      "idempotency": {
        "mode": "none",
        "key_scope": "none",
        "on_resume": "manual_review"
      },
      "on_failure": "branch_stop_cleanup"
    },
    {
      "id": "delete_trial_tracks",
      "title": "Delete trial tracks",
      "summary": "Delete bounded track refs created during the trial.",
      "uses": "call_template",
      "call_template": {
        "id": "template.tracks.delete_tracks",
        "input": {},
        "refs": {
          "track_ref": {
            "kind": "track",
            "ref": "track:session:trial_created_tracks",
            "identity": {
              "scheme": "session_ledger",
              "value": "trial_created_tracks"
            }
          }
        }
      },
      "get_state": null,
      "checkpoint": "checkpoint_delete_trial_tracks",
      "evidence": "evidence_delete_trial_tracks",
      "idempotency": {
        "mode": "supported",
        "key_scope": "recipe_run",
        "on_resume": "reuse_evidence"
      },
      "on_failure": "branch_stop_cleanup"
    },
    {
      "id": "delete_trial_marker",
      "title": "Delete trial marker",
      "summary": "Delete one bounded marker ref created during the trial.",
      "uses": "call_template",
      "call_template": {
        "id": "template.project.delete_marker",
        "input": {},
        "refs": {
          "marker_ref": {
            "kind": "marker",
            "ref": "marker:session:trial_created_marker",
            "identity": {
              "scheme": "session_ledger",
              "value": "trial_created_marker"
            }
          }
        }
      },
      "get_state": null,
      "checkpoint": "checkpoint_delete_trial_marker",
      "evidence": "evidence_delete_trial_marker",
      "idempotency": {
        "mode": "supported",
        "key_scope": "recipe_run",
        "on_resume": "reuse_evidence"
      },
      "on_failure": "branch_stop_cleanup"
    },
    {
      "id": "delete_trial_region",
      "title": "Delete trial region",
      "summary": "Delete one bounded region ref created during the trial.",
      "uses": "call_template",
      "call_template": {
        "id": "template.project.delete_region",
        "input": {},
        "refs": {
          "region_ref": {
            "kind": "region",
            "ref": "region:session:trial_created_region",
            "identity": {
              "scheme": "session_ledger",
              "value": "trial_created_region"
            }
          }
        }
      },
      "get_state": null,
      "checkpoint": "checkpoint_delete_trial_region",
      "evidence": "evidence_delete_trial_region",
      "idempotency": {
        "mode": "supported",
        "key_scope": "recipe_run",
        "on_resume": "reuse_evidence"
      },
      "on_failure": "branch_stop_cleanup"
    },
    {
      "id": "read_after_trial_cleanup",
      "title": "Read after trial cleanup",
      "summary": "Read compact project state after deleting trial-created objects.",
      "uses": "call_template",
      "call_template": {
        "id": "template.project.read_track_item_overview",
        "input": {
          "max_tracks": 64,
          "max_items_per_track": 8,
          "include_selected_items": true
        },
        "refs": {}
      },
      "get_state": null,
      "checkpoint": "checkpoint_read_after_trial_cleanup",
      "evidence": "evidence_read_after_trial_cleanup",
      "idempotency": {
        "mode": "none",
        "key_scope": "none",
        "on_resume": "rerun"
      },
      "on_failure": "branch_request_user"
    }
  ],
  "assertions": [
    {
      "id": "assert_trial_cleanup_refs",
      "kind": "expected_output",
      "summary": "The workflow must retain deleted refs and post-cleanup readback evidence.",
      "required": true,
      "evidence": [
        "evidence_delete_trial_items",
        "evidence_delete_trial_tracks",
        "evidence_delete_trial_marker",
        "evidence_delete_trial_region",
        "evidence_read_after_trial_cleanup"
      ],
      "outputs": {
        "refs": [
          "deleted_item_ref",
          "track_ref",
          "marker_ref",
          "region_ref",
          "project_ref"
        ],
        "artifacts": [],
        "jobs": [],
        "state": [
          "trial_cleanup_snapshot"
        ]
      }
    }
  ],
  "recovery": {
    "run_state": {
      "contract": "recipe.run_state.v1",
      "initial": "not_started",
      "states": [
        "not_started",
        "running",
        "paused",
        "succeeded",
        "failed",
        "blocked"
      ],
      "terminal": [
        "succeeded",
        "failed",
        "blocked"
      ]
    },
    "checkpoints": [
      {
        "id": "checkpoint_read_before_trial_cleanup",
        "after_step": "read_before_trial_cleanup",
        "required_evidence": [
          "evidence_read_before_trial_cleanup"
        ],
        "on_resume": "continue_next_step",
        "summary": "Pre-cleanup project snapshot evidence is retained."
      },
      {
        "id": "checkpoint_delete_trial_items",
        "after_step": "delete_trial_items",
        "required_evidence": [
          "evidence_delete_trial_items"
        ],
        "on_resume": "continue_next_step",
        "summary": "Trial item deletion evidence is retained."
      },
      {
        "id": "checkpoint_delete_trial_tracks",
        "after_step": "delete_trial_tracks",
        "required_evidence": [
          "evidence_delete_trial_tracks"
        ],
        "on_resume": "continue_next_step",
        "summary": "Trial track deletion evidence is retained."
      },
      {
        "id": "checkpoint_delete_trial_marker",
        "after_step": "delete_trial_marker",
        "required_evidence": [
          "evidence_delete_trial_marker"
        ],
        "on_resume": "continue_next_step",
        "summary": "Trial marker deletion evidence is retained."
      },
      {
        "id": "checkpoint_delete_trial_region",
        "after_step": "delete_trial_region",
        "required_evidence": [
          "evidence_delete_trial_region"
        ],
        "on_resume": "continue_next_step",
        "summary": "Trial region deletion evidence is retained."
      },
      {
        "id": "checkpoint_read_after_trial_cleanup",
        "after_step": "read_after_trial_cleanup",
        "required_evidence": [
          "evidence_read_after_trial_cleanup"
        ],
        "on_resume": "continue_next_step",
        "summary": "Post-cleanup project snapshot evidence is retained."
      }
    ],
    "evidence_requirements": [
      {
        "id": "evidence_read_before_trial_cleanup",
        "step": "read_before_trial_cleanup",
        "source": "template.runtime.evidence.v1",
        "template_id": "template.project.read_track_item_overview",
        "require_ok": true,
        "require_request_id": true,
        "counts": {
          "refs_min": 1,
          "artifacts_min": 0,
          "jobs_min": 0,
          "last_result_refs_min": 0
        },
        "timestamps": "current_run"
      },
      {
        "id": "evidence_delete_trial_items",
        "step": "delete_trial_items",
        "source": "template.runtime.evidence.v1",
        "template_id": "template.items.delete_items",
        "require_ok": true,
        "require_request_id": true,
        "counts": {
          "refs_min": 1,
          "artifacts_min": 0,
          "jobs_min": 0,
          "last_result_refs_min": 0
        },
        "timestamps": "current_run"
      },
      {
        "id": "evidence_delete_trial_tracks",
        "step": "delete_trial_tracks",
        "source": "template.runtime.evidence.v1",
        "template_id": "template.tracks.delete_tracks",
        "require_ok": true,
        "require_request_id": true,
        "counts": {
          "refs_min": 1,
          "artifacts_min": 0,
          "jobs_min": 0,
          "last_result_refs_min": 0
        },
        "timestamps": "current_run"
      },
      {
        "id": "evidence_delete_trial_marker",
        "step": "delete_trial_marker",
        "source": "template.runtime.evidence.v1",
        "template_id": "template.project.delete_marker",
        "require_ok": true,
        "require_request_id": true,
        "counts": {
          "refs_min": 1,
          "artifacts_min": 0,
          "jobs_min": 0,
          "last_result_refs_min": 0
        },
        "timestamps": "current_run"
      },
      {
        "id": "evidence_delete_trial_region",
        "step": "delete_trial_region",
        "source": "template.runtime.evidence.v1",
        "template_id": "template.project.delete_region",
        "require_ok": true,
        "require_request_id": true,
        "counts": {
          "refs_min": 1,
          "artifacts_min": 0,
          "jobs_min": 0,
          "last_result_refs_min": 0
        },
        "timestamps": "current_run"
      },
      {
        "id": "evidence_read_after_trial_cleanup",
        "step": "read_after_trial_cleanup",
        "source": "template.runtime.evidence.v1",
        "template_id": "template.project.read_track_item_overview",
        "require_ok": true,
        "require_request_id": true,
        "counts": {
          "refs_min": 1,
          "artifacts_min": 0,
          "jobs_min": 0,
          "last_result_refs_min": 0
        },
        "timestamps": "current_run"
      }
    ],
    "idempotency": {
      "scope": "recipe_run",
      "default_step_policy": "follow_step_idempotency",
      "on_resume": "skip_completed_checkpoints",
      "on_replay": "reuse_verified_evidence"
    },
    "resume": {
      "from_checkpoint": "latest_verified",
      "on_missing_evidence": "rerun_step",
      "on_failed_evidence": "use_recovery_branch",
      "on_risk_gate": "pause_for_user"
    },
    "branches": [
      {
        "id": "branch_request_user",
        "trigger": "template_error",
        "step": null,
        "strategy": "request_user",
        "summary": "Request user clarification when cleanup refs or ownership are ambiguous."
      },
      {
        "id": "branch_stop_cleanup",
        "trigger": "template_error",
        "step": "delete_trial_items",
        "strategy": "stop",
        "summary": "Stop cleanup instead of broadening deletion scope."
      }
    ],
    "risk_gates": [
      {
        "id": "gate_confirm_trial_object_delete",
        "applies_to": [
          "destructive"
        ],
        "required_before_step": "delete_trial_items",
        "policy": "user_confirmation",
        "blocks_auto_resume": true,
        "summary": "Confirm that all trial object refs are session-created or explicitly approved for deletion."
      }
    ]
  }
}
