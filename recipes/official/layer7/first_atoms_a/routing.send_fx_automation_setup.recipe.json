{
  "contract": "recipe.contract.v1",
  "id": "recipe.routing.send_fx_automation_setup",
  "title": "Send FX automation setup",
  "summary": "Draft write-risk family recipe that creates one send, adds one destination-track FX, reads FX parameters, resolves the send volume envelope, and inserts one automation point.",
  "pack": "routing",
  "lifecycle": "draft",
  "risk": "write",
  "entity_kind": "send_fx_automation_setup",
  "tags": [
    "routing",
    "send",
    "fx",
    "automation",
    "envelope",
    "setup",
    "e6_family"
  ],
  "workflow_card": {
    "intent": "Send FX automation setup as a lightweight agent procedure over accepted static atoms.",
    "entry_conditions": [
      "Use screenshot-first target disambiguation when a screenshot exists.",
      "Read bounded state and resolve refs before mutation."
    ],
    "supported_steps": [
      "Follow declared recipe step order with call_template and get_state only.",
      "Perform one readback or evidence check after mutation.",
      "Retain compact template runtime evidence with request ids."
    ],
    "candidate_steps": [
      "A2-C may add cleanup or delete parity where accepted atoms exist."
    ],
    "blocked_steps": [
      "Do not use public call_recipe or a hidden recipe executor.",
      "Do not claim live recipe support beyond accepted evidence."
    ],
    "required_questions": [
      "Ask when target object, destination, or mutation scope is ambiguous."
    ],
    "template_atoms": [
      "template.routing.create_track_send",
      "template.routing.set_send_volume",
      "template.fx.add_track_fx",
      "template.fx.list_fx_parameters",
      "template.automation.resolve_send_envelope",
      "template.automation.insert_envelope_point"
    ],
    "evidence_required": [
      "template.runtime.evidence.v1 with request id",
      "compact file evidence before long chat output"
    ],
    "cleanup_plan": "Use returned refs for cleanup when delete atoms exist; otherwise stop with a typed blocker.",
    "typed_blockers": [
      "no_public_call_recipe_executor"
    ],
    "token_budget": {
      "menu_max_bytes": 4096,
      "exact_max_bytes": 32768,
      "compact_chat_max_items": 5,
      "same_typed_blocker_stop_after": 2
    }
  },
  "steps": [
    {
      "id": "read_project_state",
      "title": "Read project state",
      "summary": "Read bounded project state before routing, FX, and automation writes.",
      "uses": "get_state",
      "call_template": null,
      "get_state": {
        "projection": "project.summary",
        "refs": []
      },
      "checkpoint": "checkpoint_read_project_state",
      "evidence": null,
      "idempotency": {
        "mode": "read_only",
        "key_scope": "none",
        "on_resume": "rerun"
      },
      "on_failure": "branch_request_user"
    },
    {
      "id": "create_track_send",
      "title": "Create track send",
      "summary": "Create one ordinary source-to-destination track send.",
      "uses": "call_template",
      "call_template": {
        "id": "template.routing.create_track_send",
        "input": {
          "duplicate_policy": "reject_existing"
        },
        "refs": {
          "source_track_ref": {
            "kind": "track",
            "ref": "track:selection:source_bounded",
            "identity": {
              "scheme": "selection",
              "value": "source_bounded"
            }
          },
          "destination_track_ref": {
            "kind": "track",
            "ref": "track:selection:destination_bounded",
            "identity": {
              "scheme": "selection",
              "value": "destination_bounded"
            }
          }
        }
      },
      "get_state": null,
      "checkpoint": "checkpoint_create_track_send",
      "evidence": "evidence_create_track_send",
      "idempotency": {
        "mode": "supported",
        "key_scope": "recipe_run",
        "on_resume": "reuse_evidence"
      },
      "on_failure": "branch_retry_send_setup"
    },
    {
      "id": "set_send_volume",
      "title": "Set send volume",
      "summary": "Set the created send to unity gain.",
      "uses": "call_template",
      "call_template": {
        "id": "template.routing.set_send_volume",
        "input": {
          "volume": 1
        },
        "refs": {
          "send_ref": {
            "$from_step": "create_track_send",
            "output": "send_ref"
          }
        }
      },
      "get_state": null,
      "checkpoint": "checkpoint_set_send_volume",
      "evidence": "evidence_set_send_volume",
      "idempotency": {
        "mode": "supported",
        "key_scope": "recipe_run",
        "on_resume": "reuse_evidence"
      },
      "on_failure": "branch_retry_send_setup"
    },
    {
      "id": "add_destination_fx",
      "title": "Add destination FX",
      "summary": "Add one named FX to the destination track and retain the FX ref.",
      "uses": "call_template",
      "call_template": {
        "id": "template.fx.add_track_fx",
        "input": {
          "plugin_name": "ReaEQ (Cockos)",
          "insert_at_index": 0
        },
        "refs": {
          "track_ref": {
            "kind": "track",
            "ref": "track:selection:destination_bounded",
            "identity": {
              "scheme": "selection",
              "value": "destination_bounded"
            }
          }
        }
      },
      "get_state": null,
      "checkpoint": "checkpoint_add_destination_fx",
      "evidence": "evidence_add_destination_fx",
      "idempotency": {
        "mode": "none",
        "key_scope": "none",
        "on_resume": "rerun"
      },
      "on_failure": "branch_retry_fx_setup"
    },
    {
      "id": "list_fx_parameters",
      "title": "List FX parameters",
      "summary": "Read a bounded parameter list from the newly added FX.",
      "uses": "call_template",
      "call_template": {
        "id": "template.fx.list_fx_parameters",
        "input": {
          "limit": 16
        },
        "refs": {
          "fx_ref": {
            "$from_step": "add_destination_fx",
            "output": "fx_ref"
          }
        }
      },
      "get_state": null,
      "checkpoint": "checkpoint_list_fx_parameters",
      "evidence": "evidence_list_fx_parameters",
      "idempotency": {
        "mode": "none",
        "key_scope": "none",
        "on_resume": "rerun"
      },
      "on_failure": "branch_retry_fx_setup"
    },
    {
      "id": "resolve_send_envelope",
      "title": "Resolve send envelope",
      "summary": "Resolve the created send volume envelope for automation setup.",
      "uses": "call_template",
      "call_template": {
        "id": "template.automation.resolve_send_envelope",
        "input": {
          "envelope_type": "volume"
        },
        "refs": {
          "send_ref": {
            "$from_step": "create_track_send",
            "output": "send_ref"
          }
        }
      },
      "get_state": null,
      "checkpoint": "checkpoint_resolve_send_envelope",
      "evidence": "evidence_resolve_send_envelope",
      "idempotency": {
        "mode": "none",
        "key_scope": "none",
        "on_resume": "rerun"
      },
      "on_failure": "branch_retry_automation_setup"
    },
    {
      "id": "insert_envelope_point",
      "title": "Insert envelope point",
      "summary": "Insert one automation point on the resolved send envelope.",
      "uses": "call_template",
      "call_template": {
        "id": "template.automation.insert_envelope_point",
        "input": {
          "time_seconds": 1,
          "value": 0.75,
          "shape": 0,
          "tension": 0,
          "selected": false
        },
        "refs": {
          "envelope_ref": {
            "$from_step": "resolve_send_envelope",
            "output": "envelope_ref"
          }
        }
      },
      "get_state": null,
      "checkpoint": "checkpoint_insert_envelope_point",
      "evidence": "evidence_insert_envelope_point",
      "idempotency": {
        "mode": "none",
        "key_scope": "none",
        "on_resume": "rerun"
      },
      "on_failure": "branch_retry_automation_setup"
    }
  ],
  "assertions": [
    {
      "id": "assert_send_fx_automation_refs",
      "kind": "expected_output",
      "summary": "The family run must retain send, FX, and envelope refs from the composed atoms.",
      "required": true,
      "evidence": [
        "evidence_create_track_send",
        "evidence_set_send_volume",
        "evidence_add_destination_fx",
        "evidence_resolve_send_envelope",
        "evidence_insert_envelope_point"
      ],
      "outputs": {
        "refs": [
          "send_ref",
          "fx_ref",
          "envelope_ref"
        ],
        "artifacts": [],
        "jobs": [],
        "state": [
          "send_fx_automation_setup_graph"
        ]
      }
    },
    {
      "id": "assert_no_live_support_claim",
      "kind": "checkpoint",
      "summary": "The family is draft/fake only and does not claim live routing, FX, or automation support.",
      "required": true,
      "evidence": [
        "evidence_insert_envelope_point"
      ],
      "outputs": {
        "refs": [],
        "artifacts": [],
        "jobs": [],
        "state": []
      }
    }
  ],
  "recovery": {
    "run_state": {
      "contract": "recipe.run_state.v1",
      "initial": "not_started",
      "states": [
        "not_started",
        "running",
        "paused",
        "succeeded",
        "failed",
        "blocked"
      ],
      "terminal": [
        "succeeded",
        "failed",
        "blocked"
      ]
    },
    "checkpoints": [
      {
        "id": "checkpoint_read_project_state",
        "after_step": "read_project_state",
        "required_evidence": [],
        "on_resume": "continue_next_step",
        "summary": "Fresh bounded project state was read before routing, FX, and automation writes."
      },
      {
        "id": "checkpoint_create_track_send",
        "after_step": "create_track_send",
        "required_evidence": [
          "evidence_create_track_send"
        ],
        "on_resume": "continue_next_step",
        "summary": "Created send evidence is retained."
      },
      {
        "id": "checkpoint_set_send_volume",
        "after_step": "set_send_volume",
        "required_evidence": [
          "evidence_set_send_volume"
        ],
        "on_resume": "continue_next_step",
        "summary": "Send volume mutation evidence is retained."
      },
      {
        "id": "checkpoint_add_destination_fx",
        "after_step": "add_destination_fx",
        "required_evidence": [
          "evidence_add_destination_fx"
        ],
        "on_resume": "continue_next_step",
        "summary": "Added FX evidence is retained."
      },
      {
        "id": "checkpoint_list_fx_parameters",
        "after_step": "list_fx_parameters",
        "required_evidence": [
          "evidence_list_fx_parameters"
        ],
        "on_resume": "continue_next_step",
        "summary": "FX parameter read evidence is retained."
      },
      {
        "id": "checkpoint_resolve_send_envelope",
        "after_step": "resolve_send_envelope",
        "required_evidence": [
          "evidence_resolve_send_envelope"
        ],
        "on_resume": "continue_next_step",
        "summary": "Send envelope resolution evidence is retained."
      },
      {
        "id": "checkpoint_insert_envelope_point",
        "after_step": "insert_envelope_point",
        "required_evidence": [
          "evidence_insert_envelope_point"
        ],
        "on_resume": "continue_next_step",
        "summary": "Envelope point insertion evidence is retained."
      }
    ],
    "evidence_requirements": [
      {
        "id": "evidence_create_track_send",
        "step": "create_track_send",
        "source": "template.runtime.evidence.v1",
        "template_id": "template.routing.create_track_send",
        "require_ok": true,
        "require_request_id": true,
        "counts": {
          "refs_min": 1,
          "artifacts_min": 0,
          "jobs_min": 0,
          "last_result_refs_min": 0
        },
        "timestamps": "current_run"
      },
      {
        "id": "evidence_set_send_volume",
        "step": "set_send_volume",
        "source": "template.runtime.evidence.v1",
        "template_id": "template.routing.set_send_volume",
        "require_ok": true,
        "require_request_id": true,
        "counts": {
          "refs_min": 1,
          "artifacts_min": 0,
          "jobs_min": 0,
          "last_result_refs_min": 0
        },
        "timestamps": "current_run"
      },
      {
        "id": "evidence_add_destination_fx",
        "step": "add_destination_fx",
        "source": "template.runtime.evidence.v1",
        "template_id": "template.fx.add_track_fx",
        "require_ok": true,
        "require_request_id": true,
        "counts": {
          "refs_min": 1,
          "artifacts_min": 0,
          "jobs_min": 0,
          "last_result_refs_min": 0
        },
        "timestamps": "current_run"
      },
      {
        "id": "evidence_list_fx_parameters",
        "step": "list_fx_parameters",
        "source": "template.runtime.evidence.v1",
        "template_id": "template.fx.list_fx_parameters",
        "require_ok": true,
        "require_request_id": true,
        "counts": {
          "refs_min": 0,
          "artifacts_min": 0,
          "jobs_min": 0,
          "last_result_refs_min": 0
        },
        "timestamps": "current_run"
      },
      {
        "id": "evidence_resolve_send_envelope",
        "step": "resolve_send_envelope",
        "source": "template.runtime.evidence.v1",
        "template_id": "template.automation.resolve_send_envelope",
        "require_ok": true,
        "require_request_id": true,
        "counts": {
          "refs_min": 1,
          "artifacts_min": 0,
          "jobs_min": 0,
          "last_result_refs_min": 0
        },
        "timestamps": "current_run"
      },
      {
        "id": "evidence_insert_envelope_point",
        "step": "insert_envelope_point",
        "source": "template.runtime.evidence.v1",
        "template_id": "template.automation.insert_envelope_point",
        "require_ok": true,
        "require_request_id": true,
        "counts": {
          "refs_min": 1,
          "artifacts_min": 0,
          "jobs_min": 0,
          "last_result_refs_min": 0
        },
        "timestamps": "current_run"
      }
    ],
    "idempotency": {
      "scope": "recipe_run",
      "default_step_policy": "follow_step_idempotency",
      "on_resume": "skip_completed_checkpoints",
      "on_replay": "reuse_verified_evidence"
    },
    "resume": {
      "from_checkpoint": "latest_verified",
      "on_missing_evidence": "rerun_step",
      "on_failed_evidence": "use_recovery_branch",
      "on_risk_gate": "pause_for_user"
    },
    "branches": [
      {
        "id": "branch_retry_send_setup",
        "trigger": "template_error",
        "step": null,
        "strategy": "retry_step",
        "summary": "Retry send setup only when source and destination track refs remain current."
      },
      {
        "id": "branch_retry_fx_setup",
        "trigger": "template_error",
        "step": null,
        "strategy": "retry_step",
        "summary": "Retry FX setup only after confirming the destination track is still correct."
      },
      {
        "id": "branch_retry_automation_setup",
        "trigger": "template_error",
        "step": null,
        "strategy": "retry_step",
        "summary": "Retry automation setup only from retained send and envelope evidence."
      },
      {
        "id": "branch_request_user",
        "trigger": "risk_gate_blocked",
        "step": null,
        "strategy": "request_user",
        "summary": "Pause when track, send, FX, or envelope identity needs review."
      }
    ],
    "risk_gates": [
      {
        "id": "gate_fresh_state",
        "applies_to": [
          "write"
        ],
        "required_before_step": "create_track_send",
        "policy": "fresh_state",
        "blocks_auto_resume": true,
        "summary": "Require fresh bounded project state before routing, FX, and automation writes."
      },
      {
        "id": "gate_manual_approval",
        "applies_to": [
          "write"
        ],
        "required_before_step": "create_track_send",
        "policy": "manual_approval",
        "blocks_auto_resume": true,
        "summary": "Require manual approval before creating sends, adding FX, or editing automation."
      }
    ]
  }
}
