{
  "contract": "recipe.contract.v1",
  "id": "recipe.tracks.adjust_selected_track_basic_balance",
  "title": "Adjust selected track basic balance",
  "summary": "Draft write-risk workflow that applies explicit volume, pan, and width values to one bounded selected track.",
  "pack": "tracks",
  "lifecycle": "draft",
  "risk": "write",
  "entity_kind": "track_balance",
  "tags": [
    "tracks",
    "mix",
    "balance",
    "volume",
    "pan",
    "width"
  ],
  "workflow_card": {
    "intent": "Adjust one selected track through accepted mixer-control atoms with a readback check.",
    "entry_conditions": [
      "Use screenshot-first target disambiguation when a screenshot exists.",
      "Require exactly one intended selected track before mutation."
    ],
    "supported_steps": [
      "Read selected-track mixer controls.",
      "Set volume, pan, and width through accepted atoms.",
      "Read mixer controls again for compact evidence."
    ],
    "candidate_steps": [
      "Future lanes may add named presets after recipe-level evidence."
    ],
    "blocked_steps": [
      "Do not use public call_recipe or a hidden recipe executor.",
      "Do not target master-track controls through this recipe."
    ],
    "required_questions": [
      "Ask for explicit volume, pan, and width values when they are not provided."
    ],
    "template_atoms": [
      "template.tracks.read_mixer_controls",
      "template.tracks.set_volume",
      "template.tracks.set_pan",
      "template.tracks.set_width"
    ],
    "evidence_required": [
      "template.runtime.evidence.v1 with request id",
      "compact file evidence before long chat output"
    ],
    "cleanup_plan": "No automatic reset is implied; use readback evidence and user-approved values.",
    "typed_blockers": [
      "no_public_call_recipe_executor",
      "master_track_ref_kind_not_in_frozen_ref_contract"
    ],
    "token_budget": {
      "menu_max_bytes": 4096,
      "exact_max_bytes": 32768,
      "compact_chat_max_items": 5,
      "same_typed_blocker_stop_after": 2
    }
  },
  "steps": [
    {
      "id": "read_initial_mixer_controls",
      "title": "Read initial mixer controls",
      "summary": "Read current selected-track mixer controls before mutation.",
      "uses": "call_template",
      "call_template": {
        "id": "template.tracks.read_mixer_controls",
        "input": {
          "include_selected": true,
          "limit": 1
        },
        "refs": {}
      },
      "get_state": null,
      "checkpoint": "checkpoint_read_initial_mixer_controls",
      "evidence": "evidence_read_initial_mixer_controls",
      "idempotency": {
        "mode": "none",
        "key_scope": "none",
        "on_resume": "rerun"
      },
      "on_failure": "branch_request_user"
    },
    {
      "id": "set_track_volume",
      "title": "Set track volume",
      "summary": "Set the selected track to an explicit linear volume.",
      "uses": "call_template",
      "call_template": {
        "id": "template.tracks.set_volume",
        "input": {
          "volume": 0.8
        },
        "refs": {
          "track_ref": {
            "kind": "track",
            "ref": "track:selection:single_bounded",
            "identity": {
              "scheme": "selection",
              "value": "single_bounded"
            }
          }
        }
      },
      "get_state": null,
      "checkpoint": "checkpoint_set_track_volume",
      "evidence": "evidence_set_track_volume",
      "idempotency": {
        "mode": "supported",
        "key_scope": "recipe_run",
        "on_resume": "reuse_evidence"
      },
      "on_failure": "branch_retry_balance"
    },
    {
      "id": "set_track_pan",
      "title": "Set track pan",
      "summary": "Set the same selected track to an explicit center pan.",
      "uses": "call_template",
      "call_template": {
        "id": "template.tracks.set_pan",
        "input": {
          "pan": 0
        },
        "refs": {
          "track_ref": {
            "$from_step": "set_track_volume",
            "output": "track_ref"
          }
        }
      },
      "get_state": null,
      "checkpoint": "checkpoint_set_track_pan",
      "evidence": "evidence_set_track_pan",
      "idempotency": {
        "mode": "supported",
        "key_scope": "recipe_run",
        "on_resume": "reuse_evidence"
      },
      "on_failure": "branch_retry_balance"
    },
    {
      "id": "set_track_width",
      "title": "Set track width",
      "summary": "Set the same selected track to explicit normal stereo width.",
      "uses": "call_template",
      "call_template": {
        "id": "template.tracks.set_width",
        "input": {
          "width": 1
        },
        "refs": {
          "track_ref": {
            "$from_step": "set_track_pan",
            "output": "track_ref"
          }
        }
      },
      "get_state": null,
      "checkpoint": "checkpoint_set_track_width",
      "evidence": "evidence_set_track_width",
      "idempotency": {
        "mode": "supported",
        "key_scope": "recipe_run",
        "on_resume": "reuse_evidence"
      },
      "on_failure": "branch_retry_balance"
    },
    {
      "id": "read_final_mixer_controls",
      "title": "Read final mixer controls",
      "summary": "Read selected-track mixer controls after the balance mutation.",
      "uses": "call_template",
      "call_template": {
        "id": "template.tracks.read_mixer_controls",
        "input": {
          "include_selected": true,
          "limit": 1
        },
        "refs": {
          "track_ref": {
            "$from_step": "set_track_width",
            "output": "track_ref"
          }
        }
      },
      "get_state": null,
      "checkpoint": "checkpoint_read_final_mixer_controls",
      "evidence": "evidence_read_final_mixer_controls",
      "idempotency": {
        "mode": "none",
        "key_scope": "none",
        "on_resume": "rerun"
      },
      "on_failure": "branch_request_user"
    }
  ],
  "assertions": [
    {
      "id": "assert_basic_balance_track_ref",
      "kind": "expected_output",
      "summary": "The workflow must retain the adjusted track ref and final mixer readback evidence.",
      "required": true,
      "evidence": [
        "evidence_set_track_volume",
        "evidence_set_track_pan",
        "evidence_set_track_width",
        "evidence_read_final_mixer_controls"
      ],
      "outputs": {
        "refs": [
          "track_ref"
        ],
        "artifacts": [],
        "jobs": [],
        "state": [
          "mixer_controls"
        ]
      }
    }
  ],
  "recovery": {
    "run_state": {
      "contract": "recipe.run_state.v1",
      "initial": "not_started",
      "states": [
        "not_started",
        "running",
        "paused",
        "succeeded",
        "failed",
        "blocked"
      ],
      "terminal": [
        "succeeded",
        "failed",
        "blocked"
      ]
    },
    "checkpoints": [
      {
        "id": "checkpoint_read_initial_mixer_controls",
        "after_step": "read_initial_mixer_controls",
        "required_evidence": [
          "evidence_read_initial_mixer_controls"
        ],
        "on_resume": "continue_next_step",
        "summary": "Initial mixer control evidence is retained."
      },
      {
        "id": "checkpoint_set_track_volume",
        "after_step": "set_track_volume",
        "required_evidence": [
          "evidence_set_track_volume"
        ],
        "on_resume": "continue_next_step",
        "summary": "Volume mutation evidence is retained."
      },
      {
        "id": "checkpoint_set_track_pan",
        "after_step": "set_track_pan",
        "required_evidence": [
          "evidence_set_track_pan"
        ],
        "on_resume": "continue_next_step",
        "summary": "Pan mutation evidence is retained."
      },
      {
        "id": "checkpoint_set_track_width",
        "after_step": "set_track_width",
        "required_evidence": [
          "evidence_set_track_width"
        ],
        "on_resume": "continue_next_step",
        "summary": "Width mutation evidence is retained."
      },
      {
        "id": "checkpoint_read_final_mixer_controls",
        "after_step": "read_final_mixer_controls",
        "required_evidence": [
          "evidence_read_final_mixer_controls"
        ],
        "on_resume": "continue_next_step",
        "summary": "Final mixer readback evidence is retained."
      }
    ],
    "evidence_requirements": [
      {
        "id": "evidence_read_initial_mixer_controls",
        "step": "read_initial_mixer_controls",
        "source": "template.runtime.evidence.v1",
        "template_id": "template.tracks.read_mixer_controls",
        "require_ok": true,
        "require_request_id": true,
        "counts": {
          "refs_min": 1,
          "artifacts_min": 0,
          "jobs_min": 0,
          "last_result_refs_min": 0
        },
        "timestamps": "current_run"
      },
      {
        "id": "evidence_set_track_volume",
        "step": "set_track_volume",
        "source": "template.runtime.evidence.v1",
        "template_id": "template.tracks.set_volume",
        "require_ok": true,
        "require_request_id": true,
        "counts": {
          "refs_min": 1,
          "artifacts_min": 0,
          "jobs_min": 0,
          "last_result_refs_min": 0
        },
        "timestamps": "current_run"
      },
      {
        "id": "evidence_set_track_pan",
        "step": "set_track_pan",
        "source": "template.runtime.evidence.v1",
        "template_id": "template.tracks.set_pan",
        "require_ok": true,
        "require_request_id": true,
        "counts": {
          "refs_min": 1,
          "artifacts_min": 0,
          "jobs_min": 0,
          "last_result_refs_min": 0
        },
        "timestamps": "current_run"
      },
      {
        "id": "evidence_set_track_width",
        "step": "set_track_width",
        "source": "template.runtime.evidence.v1",
        "template_id": "template.tracks.set_width",
        "require_ok": true,
        "require_request_id": true,
        "counts": {
          "refs_min": 1,
          "artifacts_min": 0,
          "jobs_min": 0,
          "last_result_refs_min": 0
        },
        "timestamps": "current_run"
      },
      {
        "id": "evidence_read_final_mixer_controls",
        "step": "read_final_mixer_controls",
        "source": "template.runtime.evidence.v1",
        "template_id": "template.tracks.read_mixer_controls",
        "require_ok": true,
        "require_request_id": true,
        "counts": {
          "refs_min": 1,
          "artifacts_min": 0,
          "jobs_min": 0,
          "last_result_refs_min": 0
        },
        "timestamps": "current_run"
      }
    ],
    "idempotency": {
      "scope": "recipe_run",
      "default_step_policy": "follow_step_idempotency",
      "on_resume": "skip_completed_checkpoints",
      "on_replay": "reuse_verified_evidence"
    },
    "resume": {
      "from_checkpoint": "latest_verified",
      "on_missing_evidence": "rerun_step",
      "on_failed_evidence": "use_recovery_branch",
      "on_risk_gate": "pause_for_user"
    },
    "branches": [
      {
        "id": "branch_request_user",
        "trigger": "template_error",
        "step": null,
        "strategy": "request_user",
        "summary": "Request user clarification when selected-track identity or balance values are ambiguous."
      },
      {
        "id": "branch_retry_balance",
        "trigger": "template_error",
        "step": "set_track_volume",
        "strategy": "retry_step",
        "summary": "Retry the current balance step when compact evidence says it is recoverable."
      }
    ],
    "risk_gates": [
      {
        "id": "gate_confirm_selected_track_balance",
        "applies_to": [
          "write"
        ],
        "required_before_step": "set_track_volume",
        "policy": "user_confirmation",
        "blocks_auto_resume": true,
        "summary": "Confirm the selected track and explicit balance values before mutation."
      }
    ]
  }
}
