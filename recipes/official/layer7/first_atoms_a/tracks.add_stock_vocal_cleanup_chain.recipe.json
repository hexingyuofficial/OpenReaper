          "last_result_refs_min": 0
        },
        "timestamps": "current_run"
      },
      {
        "id": "evidence_add_reaeq",
        "step": "add_reaeq",
        "source": "template.runtime.evidence.v1",
        "template_id": "template.fx.add_track_fx",
        "require_ok": true,
        "require_request_id": true,
        "counts": {
          "refs_min": 1,
          "artifacts_min": 0,
          "jobs_min": 0,
          "last_result_refs_min": 0
        },
        "timestamps": "current_run"
      },
      {
        "id": "evidence_add_reacomp",
        "step": "add_reacomp",
        "source": "template.runtime.evidence.v1",
        "template_id": "template.fx.add_track_fx",
        "require_ok": true,
        "require_request_id": true,
        "counts": {
          "refs_min": 1,
          "artifacts_min": 0,
          "jobs_min": 0,
          "last_result_refs_min": 0
        },
        "timestamps": "current_run"
      },
      {
        "id": "evidence_read_final_fx_chain",
        "step": "read_final_fx_chain",
        "source": "template.runtime.evidence.v1",
        "template_id": "template.fx.list_track_fx_chain",
        "require_ok": true,
        "require_request_id": true,
        "counts": {
          "refs_min": 1,
          "artifacts_min": 0,
          "jobs_min": 0,
          "last_result_refs_min": 0
        },
        "timestamps": "current_run"
      }
    ],
    "idempotency": {
      "scope": "recipe_run",
      "default_step_policy": "follow_step_idempotency",
      "on_resume": "skip_completed_checkpoints",
      "on_replay": "reuse_verified_evidence"
    },
    "resume": {
      "from_checkpoint": "latest_verified",
      "on_missing_evidence": "rerun_step",
      "on_failed_evidence": "use_recovery_branch",
      "on_risk_gate": "pause_for_user"
    },
    "branches": [
      {
        "id": "branch_retry_stock_chain",
        "trigger": "template_error",
        "step": "add_reagate",
        "strategy": "retry_step",
        "summary": "Retry the current stock FX insertion when the selected track remains stable."
      },
      {
        "id": "branch_request_user",
        "trigger": "resume_conflict",
        "step": null,
        "strategy": "request_user",
        "summary": "Pause if selected track or stock plugin availability is ambiguous."
      }
    ],
    "risk_gates": [
      {
        "id": "gate_confirm_stock_vocal_cleanup_chain",
        "applies_to": [
          "write"
        ],
        "required_before_step": "add_reagate",
        "policy": "user_confirmation",
        "blocks_auto_resume": true,
        "summary": "Confirm before adding the stock vocal cleanup FX chain."
      }
    ]
  }
