{
  "contract": "recipe.contract.v1",
  "id": "recipe.media.beat_from_selected_item_slices",
  "title": "Beat from selected item slices",
  "summary": "Draft write-risk Alpha3 starter workflow that turns one selected recorded item and project media source into a three-track kick/snare/hat slice loop.",
  "pack": "media",
  "lifecycle": "draft",
  "risk": "write",
  "entity_kind": "beat_from_slices",
  "tags": [
    "media",
    "items",
    "tracks",
    "slice",
    "beat",
    "kick",
    "snare",
    "hat",
    "starter_recipe",
    "alpha3",
    "product_surface"
  ],
  "workflow_card": {
    "intent": "Create a simple three-track source-slice beat starter with fewer manual decisions and compact readback.",
    "entry_conditions": [
      "Use when the user selected a recorded audio item and wants a starter kick/snare/hat loop from slices.",
      "The current project must expose the source media through project media file refs."
    ],
    "supported_steps": [
      "Resolve and read the selected source item.",
      "Detect transient evidence for slice-picking context.",
      "Read bounded project media file refs.",
      "Create kick, snare, and hat target tracks.",
      "Import three fixed starter source sections, set loop points, and create a loop region."
    ],
    "candidate_steps": [
      "Future versions should bind the selected item exact take source, choose slice windows from transient payloads, duplicate to grid, pitch and level slices, and/or load RS5k pads."
    ],
    "blocked_steps": [
      "Do not use public call_recipe or a hidden recipe executor.",
      "Do not claim automatic best-slice selection, sampler drum rack creation, duplicate-to-grid batching, or live support from this starter."
    ],
    "required_questions": [
      "Ask before scanning private folders or importing media outside the current project media set.",
      "Ask before deleting or replacing existing beat tracks."
    ],
    "template_atoms": [
      "template.items.resolve_item_ref",
      "template.items.read_item_summary",
      "template.analysis.detect_item_transients",
      "template.media.read_project_media_files",
      "template.tracks.create_track",
      "template.media.import_file_section_to_track",
      "template.transport.set_loop_points",
      "template.project.create_region"
    ],
    "evidence_required": [
      "template.runtime.evidence.v1 with request id",
      "transient artifact ref for the selected source item",
      "three imported item refs and final item readback"
    ],
    "cleanup_plan": "If the beat starter is unwanted, delete only the three created tracks after user confirmation.",
    "typed_blockers": [
      "no_public_call_recipe_executor",
      "selected_item_required",
      "project_media_source_required",
      "fixed_slice_starter_not_transient_solver",
      "sampler_loader_missing"
    ],
    "token_budget": {
      "menu_max_bytes": 4096,
      "exact_max_bytes": 32768,
      "compact_chat_max_items": 5,
      "same_typed_blocker_stop_after": 2
    }
  },
  "steps": [
    {
      "id": "read_project_state",
      "title": "Read project state",
      "summary": "Read bounded project state before creating beat tracks.",
      "uses": "get_state",
      "call_template": null,
      "get_state": {
        "projection": "project.summary",
        "refs": []
      },
      "checkpoint": "checkpoint_read_project_state",
      "evidence": null,
      "idempotency": {
        "mode": "read_only",
        "key_scope": "none",
        "on_resume": "rerun"
      },
      "on_failure": "branch_request_user"
    },
    {
      "id": "resolve_source_item",
      "title": "Resolve selected source item",
      "summary": "Resolve selected:0 as the recorded source item for slice analysis.",
      "uses": "call_template",
      "call_template": {
        "id": "template.items.resolve_item_ref",
        "input": {
          "ref": "selected:0"
        },
        "refs": {}
      },
      "get_state": null,
      "checkpoint": "checkpoint_resolve_source_item",
      "evidence": "evidence_resolve_source_item",
      "idempotency": {
        "mode": "none",
        "key_scope": "none",
        "on_resume": "rerun"
      },
      "on_failure": "branch_request_user"
    },
    {
