    "idempotency": {
      "scope": "recipe_run",
      "default_step_policy": "follow_step_idempotency",
      "on_resume": "skip_completed_checkpoints",
      "on_replay": "reuse_verified_evidence"
    },
    "resume": {
      "from_checkpoint": "latest_verified",
      "on_missing_evidence": "rerun_step",
      "on_failed_evidence": "use_recovery_branch",
      "on_risk_gate": "pause_for_user"
    },
    "branches": [
      {
        "id": "branch_continue_with_start_alignment",
        "trigger": "template_error",
        "step": "detect_moving_transients",
        "strategy": "request_user",
        "summary": "Continue only as a visible start-alignment fallback if analysis evidence is weak."
      },
      {
        "id": "branch_request_user",
        "trigger": "resume_conflict",
        "step": null,
        "strategy": "request_user",
        "summary": "Pause if the selected items changed or the desired anchor is unclear."
      }
    ],
    "risk_gates": [
      {
        "id": "gate_confirm_two_item_alignment",
        "applies_to": [
          "write"
        ],
        "required_before_step": "move_item_to_anchor_start",
        "policy": "user_confirmation",
        "blocks_auto_resume": true,
        "summary": "Confirm before moving the second selected item."
      }
