{
  "contract": "recipe.contract.v1",
  "id": "recipe.items.align_selected_item_onsets",
  "title": "Align selected item onsets",
  "summary": "Draft write-risk Alpha3 starter workflow that analyzes two selected items and aligns the second item to the first item start.",
  "pack": "items",
  "lifecycle": "draft",
  "risk": "write",
  "entity_kind": "item_onset_alignment",
  "tags": [
    "items",
    "analysis",
    "transient",
    "silence",
    "alignment",
    "move",
    "starter_recipe",
    "alpha3",
    "product_surface"
  ],
  "workflow_card": {
    "intent": "Align a second selected layer to the first selected layer with analysis evidence and compact readback.",
    "entry_conditions": [
      "Use when two selected audio items should start together or be layer-aligned.",
      "Treat selected:0 as the anchor and selected:1 as the item to move."
    ],
    "supported_steps": [
      "List selected items and read anchor/moving item summaries.",
      "Detect transient and silence evidence before moving.",
      "Move the second item to the anchor start and read it back."
    ],
    "candidate_steps": [
      "Future bridge handlers should move by detected onset offset, not only item start."
    ],
    "blocked_steps": [
      "Do not use public call_recipe or a hidden recipe executor.",
      "Do not claim arbitrary multi-item transient alignment from this starter."
    ],
    "required_questions": [
      "Ask before moving more than the two selected starter items."
    ],
    "template_atoms": [
      "template.items.list_selected_items",
      "template.items.resolve_item_ref",
      "template.items.read_item_summary",
      "template.analysis.detect_item_transients",
      "template.analysis.detect_item_silence",
      "template.items.move_item"
    ],
    "evidence_required": [
      "template.runtime.evidence.v1 with request id",
      "anchor and moved item readback after alignment"
    ],
    "cleanup_plan": "If alignment is unwanted, move the second item back using its pre-move position from readback evidence.",
    "typed_blockers": [
      "no_public_call_recipe_executor",
      "two_selected_items_required",
      "onset_offset_handler_missing"
    ],
    "token_budget": {
      "menu_max_bytes": 4096,
      "exact_max_bytes": 32768,
      "compact_chat_max_items": 5,
      "same_typed_blocker_stop_after": 2
    }
  },
  "steps": [
    {
      "id": "list_selected_items",
      "title": "List selected items",
      "summary": "Read the selected item set before choosing the two starter alignment targets.",
      "uses": "call_template",
      "call_template": {
        "id": "template.items.list_selected_items",
        "input": {
          "limit": 2,
          "include_track_refs": true
        },
        "refs": {}
      },
      "get_state": null,
      "checkpoint": "checkpoint_list_selected_items",
      "evidence": "evidence_list_selected_items",
      "idempotency": {
        "mode": "none",
        "key_scope": "none",
        "on_resume": "rerun"
      },
      "on_failure": "branch_request_user"
    },
    {
      "id": "resolve_anchor_item",
      "title": "Resolve anchor item",
      "summary": "Resolve selected:0 as the alignment anchor item.",
      "uses": "call_template",
      "call_template": {
        "id": "template.items.resolve_item_ref",
        "input": {
          "ref": "selected:0"
        },
        "refs": {}
      },
      "get_state": null,
      "checkpoint": "checkpoint_resolve_anchor_item",
      "evidence": "evidence_resolve_anchor_item",
      "idempotency": {
        "mode": "none",
        "key_scope": "none",
        "on_resume": "rerun"
      },
      "on_failure": "branch_request_user"
    },
    {
      "id": "resolve_moving_item",
      "title": "Resolve moving item",
      "summary": "Resolve selected:1 as the item to move toward the anchor.",
      "uses": "call_template",
      "call_template": {
        "id": "template.items.resolve_item_ref",
        "input": {
          "ref": "selected:1"
        },
        "refs": {}
      },
      "get_state": null,
      "checkpoint": "checkpoint_resolve_moving_item",
      "evidence": "evidence_resolve_moving_item",
      "idempotency": {
        "mode": "none",
        "key_scope": "none",
        "on_resume": "rerun"
      },
      "on_failure": "branch_request_user"
    },
    {
      "id": "read_anchor_item",
      "title": "Read anchor item",
      "summary": "Read compact anchor item timing and active-take facts.",
      "uses": "call_template",
      "call_template": {
        "id": "template.items.read_item_summary",
        "input": {
          "include_take_summary": true
        },
        "refs": {
          "item_ref": {
            "$from_step": "resolve_anchor_item",
            "output": "item_ref"
          }
        }
      },
      "get_state": null,
      "checkpoint": "checkpoint_read_anchor_item",
      "evidence": "evidence_read_anchor_item",
      "idempotency": {
        "mode": "none",
        "key_scope": "none",
        "on_resume": "rerun"
      },
      "on_failure": "branch_request_user"
    },
    {
      "id": "read_moving_item_before",
      "title": "Read moving item before",
      "summary": "Read compact moving item facts before changing its position.",
      "uses": "call_template",
      "call_template": {
        "id": "template.items.read_item_summary",
        "input": {
          "include_take_summary": true
        },
        "refs": {
          "item_ref": {
            "$from_step": "resolve_moving_item",
            "output": "item_ref"
          }
        }
      },
      "get_state": null,
      "checkpoint": "checkpoint_read_moving_item_before",
      "evidence": "evidence_read_moving_item_before",
      "idempotency": {
        "mode": "none",
        "key_scope": "none",
        "on_resume": "rerun"
      },
      "on_failure": "branch_request_user"
    },
    {
      "id": "detect_anchor_transients",
      "title": "Detect anchor transients",
      "summary": "Detect bounded transient facts for the anchor item.",
      "uses": "call_template",
      "call_template": {
        "id": "template.analysis.detect_item_transients",
        "input": {},
        "refs": {
          "item_ref": {
            "$from_step": "read_anchor_item",
            "output": "item_ref"
          }
        }
      },
      "get_state": null,
      "checkpoint": "checkpoint_detect_anchor_transients",
      "evidence": "evidence_detect_anchor_transients",
      "idempotency": {
        "mode": "none",
        "key_scope": "none",
        "on_resume": "rerun"
      },
      "on_failure": "branch_continue_with_start_alignment"
    },
    {
      "id": "detect_moving_transients",
      "title": "Detect moving transients",
      "summary": "Detect bounded transient facts for the item that will move.",
      "uses": "call_template",
      "call_template": {
        "id": "template.analysis.detect_item_transients",
        "input": {},
        "refs": {
          "item_ref": {
            "$from_step": "read_moving_item_before",
            "output": "item_ref"
          }
        }
      },
      "get_state": null,
      "checkpoint": "checkpoint_detect_moving_transients",
      "evidence": "evidence_detect_moving_transients",
      "idempotency": {
        "mode": "none",
        "key_scope": "none",
        "on_resume": "rerun"
      },
      "on_failure": "branch_continue_with_start_alignment"
    },
    {
      "id": "detect_moving_silence",
      "title": "Detect moving silence",
      "summary": "Detect silence facts for the moving item so the agent can explain onset confidence.",
      "uses": "call_template",
      "call_template": {
        "id": "template.analysis.detect_item_silence",
        "input": {},
        "refs": {
          "item_ref": {
            "$from_step": "read_moving_item_before",
            "output": "item_ref"
          }
        }
      },
      "get_state": null,
      "checkpoint": "checkpoint_detect_moving_silence",
      "evidence": "evidence_detect_moving_silence",
      "idempotency": {
        "mode": "none",
        "key_scope": "none",
        "on_resume": "rerun"
      },
      "on_failure": "branch_continue_with_start_alignment"
    },
    {
      "id": "move_item_to_anchor_start",
      "title": "Move item to anchor start",
      "summary": "Move selected:1 to the starter anchor position at project time 0.",
      "uses": "call_template",
      "call_template": {
        "id": "template.items.move_item",
        "input": {
          "position_seconds": 0
        },
        "refs": {
          "item_ref": {
            "$from_step": "read_moving_item_before",
            "output": "item_ref"
          }
        }
      },
      "get_state": null,
      "checkpoint": "checkpoint_move_item_to_anchor_start",
      "evidence": "evidence_move_item_to_anchor_start",
      "idempotency": {
        "mode": "supported",
        "key_scope": "recipe_run",
        "on_resume": "reuse_evidence"
      },
      "on_failure": "branch_request_user"
    },
    {
      "id": "read_moving_item_after",
      "title": "Read moving item after",
      "summary": "Read compact moving item facts after alignment.",
      "uses": "call_template",
      "call_template": {
        "id": "template.items.read_item_summary",
        "input": {
          "include_take_summary": true
        },
        "refs": {
          "item_ref": {
            "$from_step": "move_item_to_anchor_start",
            "output": "item_ref"
          }
        }
      },
      "get_state": null,
      "checkpoint": "checkpoint_read_moving_item_after",
      "evidence": "evidence_read_moving_item_after",
      "idempotency": {
        "mode": "none",
        "key_scope": "none",
        "on_resume": "rerun"
      },
      "on_failure": "branch_request_user"
    }
  ],
  "assertions": [
    {
      "id": "assert_two_item_alignment_readback",
      "kind": "expected_output",
      "summary": "The workflow must retain selected item refs, analysis artifacts, and moved-item readback evidence.",
      "required": true,
      "evidence": [
        "evidence_list_selected_items",
        "evidence_read_anchor_item",
        "evidence_read_moving_item_before",
        "evidence_detect_anchor_transients",
        "evidence_detect_moving_transients",
        "evidence_detect_moving_silence",
        "evidence_move_item_to_anchor_start",
        "evidence_read_moving_item_after"
      ],
      "outputs": {
        "refs": [
          "item_ref",
          "track_ref"
        ],
        "artifacts": [
          "item_transients_report",
          "item_silence_report"
        ],
        "jobs": [],
        "state": [
          "two_item_start_alignment_ready"
        ]
      }
    },
    {
      "id": "assert_starter_not_full_transient_aligner",
      "kind": "checkpoint",
      "summary": "This starter aligns the second item to a known start position and does not claim arbitrary onset-offset solving.",
      "required": true,
      "evidence": [
        "evidence_detect_anchor_transients",
        "evidence_detect_moving_transients",
        "evidence_move_item_to_anchor_start"
      ],
      "outputs": {
        "refs": [],
        "artifacts": [],
        "jobs": [],
        "state": []
      }
    }
  ],
