{
  "contract": "recipe.contract.v1",
  "id": "recipe.tracks.cleanup_created_track_set",
  "title": "Cleanup created track set",
  "summary": "Draft destructive workflow that deletes a bounded set of session-created track refs after confirmation.",
  "pack": "tracks",
  "lifecycle": "draft",
  "risk": "destructive",
  "entity_kind": "track_cleanup",
  "tags": [
    "tracks",
    "cleanup",
    "delete",
    "session_ledger"
  ],
  "workflow_card": {
    "intent": "Clean up tracks created by an OpenReaper trial using explicit track refs.",
    "entry_conditions": [
      "Use only canonical track refs from the same session ledger or explicit user confirmation.",
      "Preview the refs before deletion."
    ],
    "supported_steps": [
      "Read compact project state before deletion.",
      "Delete explicit track refs through the accepted destructive atom.",
      "Read compact project state after deletion."
    ],
    "candidate_steps": [
      "Future lanes may add richer session-ledger projection once accepted."
    ],
    "blocked_steps": [
      "Do not use public call_recipe or a hidden recipe executor.",
      "Do not delete tracks by name-only guesses."
    ],
    "required_questions": [
      "Ask for confirmation unless every track ref is session-ledger owned."
    ],
    "template_atoms": [
      "template.project.read_track_item_overview",
      "template.tracks.delete_tracks"
    ],
    "evidence_required": [
      "template.runtime.evidence.v1 with request id",
      "compact file evidence before long chat output"
    ],
    "cleanup_plan": "This recipe is itself cleanup; stop on ambiguous refs instead of broad reset.",
    "typed_blockers": [
      "no_public_call_recipe_executor",
      "cleanup_requires_canonical_session_or_confirmed_refs"
    ],
    "token_budget": {
      "menu_max_bytes": 4096,
      "exact_max_bytes": 32768,
      "compact_chat_max_items": 5,
      "same_typed_blocker_stop_after": 2
    }
  },
  "steps": [
    {
      "id": "read_before_cleanup",
      "title": "Read before cleanup",
      "summary": "Read compact project state before deleting created tracks.",
      "uses": "call_template",
      "call_template": {
        "id": "template.project.read_track_item_overview",
        "input": {
          "max_tracks": 64,
          "max_items_per_track": 4,
          "include_selected_items": true
        },
        "refs": {}
      },
      "get_state": null,
      "checkpoint": "checkpoint_read_before_cleanup",
      "evidence": "evidence_read_before_cleanup",
      "idempotency": {
        "mode": "none",
        "key_scope": "none",
        "on_resume": "rerun"
      },
      "on_failure": "branch_request_user"
    },
    {
      "id": "delete_created_tracks",
      "title": "Delete created tracks",
      "summary": "Delete the bounded set of session-created track refs.",
      "uses": "call_template",
      "call_template": {
        "id": "template.tracks.delete_tracks",
        "input": {},
        "refs": {
          "track_ref": {
            "kind": "track",
            "ref": "track:session:created_track_set",
            "identity": {
              "scheme": "session_ledger",
              "value": "created_track_set"
            }
          }
        }
      },
      "get_state": null,
      "checkpoint": "checkpoint_delete_created_tracks",
      "evidence": "evidence_delete_created_tracks",
      "idempotency": {
        "mode": "supported",
        "key_scope": "recipe_run",
        "on_resume": "reuse_evidence"
      },
      "on_failure": "branch_stop_cleanup"
    },
    {
      "id": "read_after_cleanup",
      "title": "Read after cleanup",
      "summary": "Read compact project state after deleting created tracks.",
      "uses": "call_template",
      "call_template": {
        "id": "template.project.read_track_item_overview",
        "input": {
          "max_tracks": 64,
          "max_items_per_track": 4,
          "include_selected_items": true
        },
        "refs": {}
      },
      "get_state": null,
      "checkpoint": "checkpoint_read_after_cleanup",
      "evidence": "evidence_read_after_cleanup",
      "idempotency": {
        "mode": "none",
        "key_scope": "none",
        "on_resume": "rerun"
      },
      "on_failure": "branch_request_user"
    }
  ],
  "assertions": [
    {
      "id": "assert_deleted_track_refs",
      "kind": "expected_output",
      "summary": "The workflow must retain deleted track refs and post-cleanup readback evidence.",
      "required": true,
      "evidence": [
        "evidence_delete_created_tracks",
        "evidence_read_after_cleanup"
      ],
      "outputs": {
        "refs": [
          "track_ref",
          "project_ref"
        ],
        "artifacts": [],
        "jobs": [],
        "state": [
          "deleted_count",
          "post_cleanup_snapshot"
        ]
      }
    }
  ],
  "recovery": {
    "run_state": {
      "contract": "recipe.run_state.v1",
      "initial": "not_started",
      "states": [
        "not_started",
        "running",
        "paused",
        "succeeded",
        "failed",
        "blocked"
      ],
      "terminal": [
        "succeeded",
        "failed",
        "blocked"
      ]
    },
    "checkpoints": [
      {
        "id": "checkpoint_read_before_cleanup",
        "after_step": "read_before_cleanup",
        "required_evidence": [
          "evidence_read_before_cleanup"
        ],
        "on_resume": "continue_next_step",
        "summary": "Pre-cleanup snapshot evidence is retained."
      },
      {
        "id": "checkpoint_delete_created_tracks",
        "after_step": "delete_created_tracks",
        "required_evidence": [
          "evidence_delete_created_tracks"
        ],
        "on_resume": "continue_next_step",
        "summary": "Created-track deletion evidence is retained."
      },
      {
        "id": "checkpoint_read_after_cleanup",
        "after_step": "read_after_cleanup",
        "required_evidence": [
          "evidence_read_after_cleanup"
        ],
        "on_resume": "continue_next_step",
        "summary": "Post-cleanup snapshot evidence is retained."
      }
    ],
    "evidence_requirements": [
      {
        "id": "evidence_read_before_cleanup",
        "step": "read_before_cleanup",
        "source": "template.runtime.evidence.v1",
        "template_id": "template.project.read_track_item_overview",
        "require_ok": true,
        "require_request_id": true,
        "counts": {
          "refs_min": 1,
          "artifacts_min": 0,
          "jobs_min": 0,
          "last_result_refs_min": 0
        },
        "timestamps": "current_run"
      },
      {
        "id": "evidence_delete_created_tracks",
        "step": "delete_created_tracks",
        "source": "template.runtime.evidence.v1",
        "template_id": "template.tracks.delete_tracks",
        "require_ok": true,
        "require_request_id": true,
        "counts": {
          "refs_min": 1,
          "artifacts_min": 0,
          "jobs_min": 0,
          "last_result_refs_min": 0
        },
        "timestamps": "current_run"
      },
      {
        "id": "evidence_read_after_cleanup",
        "step": "read_after_cleanup",
        "source": "template.runtime.evidence.v1",
        "template_id": "template.project.read_track_item_overview",
        "require_ok": true,
        "require_request_id": true,
        "counts": {
          "refs_min": 1,
          "artifacts_min": 0,
          "jobs_min": 0,
          "last_result_refs_min": 0
        },
        "timestamps": "current_run"
      }
    ],
    "idempotency": {
      "scope": "recipe_run",
      "default_step_policy": "follow_step_idempotency",
      "on_resume": "skip_completed_checkpoints",
      "on_replay": "reuse_verified_evidence"
    },
    "resume": {
      "from_checkpoint": "latest_verified",
      "on_missing_evidence": "rerun_step",
      "on_failed_evidence": "use_recovery_branch",
      "on_risk_gate": "pause_for_user"
    },
    "branches": [
      {
        "id": "branch_request_user",
        "trigger": "template_error",
        "step": null,
        "strategy": "request_user",
        "summary": "Request user clarification when cleanup refs or ownership are ambiguous."
      },
      {
        "id": "branch_stop_cleanup",
        "trigger": "template_error",
        "step": "delete_created_tracks",
        "strategy": "stop",
        "summary": "Stop cleanup instead of broadening deletion scope."
      }
    ],
    "risk_gates": [
      {
        "id": "gate_confirm_created_track_delete",
        "applies_to": [
          "destructive"
        ],
        "required_before_step": "delete_created_tracks",
        "policy": "user_confirmation",
        "blocks_auto_resume": true,
        "summary": "Confirm that all track refs are session-created or explicitly approved for deletion."
      }
    ]
  }
}
